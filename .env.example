# Copy to .env (never commit it). Used by ledger-api and ledger-backend.
# Docker Compose overrides the MongoDB settings below, so for `docker compose up` only the secrets, holder and Gemini key matter.

# Comma-separated names of the people using this install. Each one gets their own database. Default: ME
PEOPLE=ME

# One block per person, prefixed with their upper-case name.
# _SECRET is their API key: the iOS/Android shortcut sends it as X-API-Key, and the frontend uses it to call the backend.
# Generate one with: openssl rand -base64 32
ME_SECRET=change-me-to-a-long-random-string
ME_MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
ME_MONGODB_DB=ledger
# Your name exactly as your bank prints it (own-account moves are detected from it)
ME_HOLDER=JANE DOE
# Optional extra rules for the SMS parser, e.g. "My main bank is HDFC."
ME_PARSE_HINT=

# LLM used for SMS parsing and chat (Google Gemini, OpenAI-compatible endpoint)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

PORT=8081

# Optional
# VAPID_PUBLIC_KEY= / VAPID_PRIVATE_KEY= / VAPID_SUBJECT=mailto:you@example.com   (push notifications; generate with `go run ./cmd/vapidgen`)
# S3_BUCKET= / AWS_REGION=   (vehicle papers and photos)
# LOGO_API_KEY= / LOGO_API_SECRET_KEY=   (company logos)
# YAHOO_CHART_URL=
# HOLDER_NAME= / IMPORT_USER=   (only for the cmd/import* statement tools)
